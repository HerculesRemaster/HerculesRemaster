# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Originals and runtime copies stay outside Git (master §5, §6.4)
# backups/
# working/

# Extracted payloads and decoded media: reproducible from manifests; coverage metadata is tracked
# extracted/*
!extracted/m

# Generated / large media
